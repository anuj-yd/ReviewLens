# Use the same username and password configured in the root .env file.
# URL-encode any special characters in the credentials.
MONGODB_URI=mongodb://replace_with_a_unique_username:replace_with_a_strong_password@localhost:27017/reviewlens?authSource=admin

# Ollama runs on the backend host; no API key is required for this local setup.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

PORT=5000
CLIENT_URL=http://localhost:5173
