# MongoDB Atlas connection string. Replace the placeholders with your Atlas
# database user and cluster host; URL-encode reserved characters in the password.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/ReviewLens?retryWrites=true&w=majority

# OpenRouter configuration. Keep the real key in backend/.env only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ReviewLens

PORT=5000
CLIENT_URL=http://localhost:5173
