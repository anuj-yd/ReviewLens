# ==============================================================================
# ReviewLens Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Variables (Required for Node.js API)
# ------------------------------------------------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ReviewLens?retryWrites=true&w=majority

# Primary LLM: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=ReviewLens

# Optional LLM Fallback: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple)
# Required when backend and frontend are hosted on separate domains (e.g. Vercel + Render).
# Can be left blank if deploying as a unified service where the backend serves the frontend.
CLIENT_URL=https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# Frontend Variables (Required during Vite build for decoupled deployments)
# ------------------------------------------------------------------------------

# Base URL of your deployed backend API (omit or leave empty if backend serves frontend)
VITE_API_URL=https://your-backend.onrender.com
